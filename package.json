  "scripts": {
    "db:generate": "prisma generate --schema=libs/prisma/prisma/schema.prisma",
    "postinstall": "prisma generate --schema=libs/prisma/prisma/schema.prisma",
    "typecheck": "tsc --project tsconfig.check.json --noEmit",
    "build": "npm run db:generate && nest build gateway",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:gateway": "nest start gateway --watch",
    "start:messaging": "nest start messaging --watch",
    "start:ai-worker": "nest start ai-worker --watch",
    "start:campaigns": "nest start campaigns --watch",
    "start:contacts": "nest start contacts --watch",
    "start:billing": "nest start billing --watch",
    "start:prod:gateway": "node dist/apps/gateway/main",
    "lint": "oxlint apps/ libs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:migrations": "node scripts/check-migrations.mjs"
  },
