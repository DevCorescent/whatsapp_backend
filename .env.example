# Backend (NestJS gateway) environment.
#
# Copy to `.env` and fill in. Both files are gitignored, so nothing here reaches a
# repository — but keep real secrets in `.env` and leave this one as placeholders, so
# that stays true if the ignore rules ever change.
#
# Only the gateway is run in development. It mounts messaging, campaigns, contacts and
# billing itself, so the other port numbers below matter only if those are run alone.

# ─── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# AES key for secrets at rest, e.g. WhatsApp access tokens. 32 bytes, hex or base64.
# Changing it makes everything already encrypted unreadable.
ENCRYPTION_KEY="change-me"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
# Shared between the Next app and the gateway so the proxy can mint service tokens.
# Must match BACKEND_SERVICE_SECRET in the Next app's .env.
SERVICE_SECRET="change-me"
# Where the browser reaches the Next app. Used for links in emails and notifications.
FRONTEND_URL="http://localhost:3000"

# ─── Ports ────────────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
MESSAGING_PORT=4001
CAMPAIGNS_PORT=4002
CONTACTS_PORT=4003
BILLING_PORT=4004
AI_WORKER_PORT=4005

# ─── Redis ────────────────────────────────────────────────────────────────────
# Queues (campaign sending, template sync, media fetch) and the realtime adapter.
# Required: the gateway will not send campaigns without it.
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS=false

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# The App ID and App Secret must come from the SAME Meta app. A mismatch passes
# webhook verification and then fails every signature check afterwards, so inbound
# messages are dropped with nothing in the log to explain it.
# App settings -> Basic, in the Meta App Dashboard.
WHATSAPP_APP_ID="your-meta-app-id"
WHATSAPP_APP_SECRET="your-meta-app-secret"
# Any string you choose. Paste the identical value into Meta's webhook form.
# Read at boot, so the gateway must be restarted after changing it.
WHATSAPP_VERIFY_TOKEN="pick-any-string"
WHATSAPP_API_VERSION="v19.0"
# Embedded Signup configuration id, for onboarding customers' own numbers.
# Not needed to test with Meta's free test number.
WHATSAPP_ES_CONFIG_ID=""

# The free test number's details, for local testing. The app does NOT read these:
# a WhatsApp connection lives in the database, created through
# Settings -> WhatsApp -> Connect. They are kept here only so they are not lost.
WA_TEST_PHONE_NUMBER_ID=""
WA_TEST_WABA_ID=""
WA_TEST_DISPLAY_NUMBER=""
# API Setup tokens expire within hours. Use a System User token for anything longer.
WA_TEST_ACCESS_TOKEN=""
# The webhook Meta points at: https://<public-host>/webhook/whatsapp
# Must tunnel the GATEWAY (4000), not the Next app — the signature is checked against
# the raw body, which proxying through Next would break.
# ngrok publishes its current URL at http://localhost:4040/api/tunnels
WA_TEST_CALLBACK_URL=""

# ─── AI ───────────────────────────────────────────────────────────────────────
# One of these is enough. OpenRouter takes precedence when both are set, and is the
# only one where a per-business model id is honoured.
# Needed for auto-replies, lead scoring and handover triage.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── Media storage (optional) ─────────────────────────────────────────────────
# S3-compatible. Without it, chat media streams from Meta and a carousel card asks
# for a public URL by hand instead of getting one from an upload.
# STORAGE_ENDPOINT=""
# STORAGE_REGION="auto"
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_PUBLIC_URL=""
