  @@index([tenantId, createdAt])
  @@map("payments")
}

/// What a reseller earned from one payment by a client it referred.
model ResellerCommission {
  id          String           @id @default(cuid())
  resellerId  String
  clientId    String
  paymentId   String           @unique
  /// Payment amount the commission was computed on, and the result, in minor units.
  baseMinor   Int
  amountMinor Int
  rate        Float
  currency    String           @default("inr")
  status      CommissionStatus @default(PENDING)
  paidAt      DateTime?
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  client      Tenant           @relation("CommissionClient", fields: [clientId], references: [id], onDelete: Cascade)
  payment     Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reseller    Tenant           @relation("CommissionReseller", fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([resellerId, status])
  @@map("reseller_commissions")
}

model RolePermission {
  id          String      @id @default(cuid())
  accountType AccountType
  role        UserRole
  permission  String
  allowed     Boolean
  updatedAt   DateTime    @default(now()) @updatedAt

  @@unique([accountType, role, permission])
  @@map("role_permissions")
}

/// Per-user permission overrides — layer 4 on top of account ceiling + role defaults + role overrides.
/// A row here grants or denies that specific permission for that user, regardless of their role.
/// Still bounded by the account ceiling (a reseller user cannot hold messages.send, for example).
model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  permission String
  allowed    Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  user       User     @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permissions")
}

model Wallet {
  id                       String    @id @default(cuid())
  tenantId                 String    @unique
  balanceMinor             Int       @default(0)
  currency                 String    @default("inr")
  lowBalanceThresholdMinor Int       @default(10000)
  lowBalanceNotifiedAt     DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id                String        @id @default(cuid())
  tenantId          String
  type              WalletTxnType
  /// Signed: positive credits, negative debits.
  amountMinor       Int
  balanceAfterMinor Int
  description       String?
  referenceType     String?
  referenceId       String?
  /// Makes a charge or credit happen at most once (e.g. "debit:<recipientId>").
  idempotencyKey    String?       @unique
  createdById       String?
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("wallet_transactions")
}

/// Price per message unit in paise. `resellerId` null = platform rate; a reseller's
/// row prices that reseller's clients (never below the platform rate).
/// What one WhatsApp template message costs, at one of three scopes. Which row applies is
/// decided by MessageRatesService: the customer's own price wins, then its reseller's price,
/// then the platform price. Exactly one row may exist per (category, scope) — enforced by
/// three partial unique indexes created in raw SQL, because a plain UNIQUE treats the NULLs
/// that mark a scope as distinct and so would allow duplicates.
/// platform  — resellerId NULL, tenantId NULL
/// reseller  — resellerId set,  tenantId NULL  (applies to all of that reseller's clients)
/// customer  — tenantId set                    (applies to that one account)
model MessageRate {
  id         String       @id @default(cuid())
  category   RateCategory @unique(map: "message_rates_platform_key", where: raw("((\"resellerId\" IS NULL) AND (\"tenantId\" IS NULL))"))
  resellerId String?
  priceMinor Int
  updatedAt  DateTime     @default(now()) @updatedAt
  tenantId   String?
  reseller   Tenant?      @relation("ResellerMessageRates", fields: [resellerId], references: [id], onDelete: Cascade)
  tenant     Tenant?      @relation("CustomerMessageRates", fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([category, tenantId], map: "message_rates_customer_key", where: raw("(\"tenantId\" IS NOT NULL)"))
  @@unique([category, resellerId], map: "message_rates_reseller_key", where: raw("((\"resellerId\" IS NOT NULL) AND (\"tenantId\" IS NULL))"))
  @@index([tenantId])
  @@index([resellerId])
  @@map("message_rates")
}

model Segment {
  id          String   @id @default(cuid())
  tenantId    String
  businessId  String
  name        String
  description String?
  /// { rules: SegmentRule[] } — see lib/segments.ts.
  filters     Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, businessId])
  @@map("segments")
}

/// A hand-picked group of contacts, built and named by whoever will send to it.
///
/// Distinct from Segment, which is a saved *rule* ("everyone tagged VIP") re-evaluated
/// on every use. A list is the opposite: an explicit set of people chosen one by one,
/// which does not change underneath the sender. Both can target a broadcast; this is the
/// one to reach for when the recipients are a decision rather than a query.
model ContactList {
  id          String              @id @default(cuid())
  tenantId    String
  businessId  String
  name        String
  description String?
  /// Who built it. Kept so a list survives the person leaving, unlike an owner column.
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  members     ContactListMember[]
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([name, businessId])
  @@index([tenantId, businessId])
  @@map("contact_lists")
}

model ContactListMember {
  listId    String
  contactId String
  addedAt   DateTime    @default(now())
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
  @@map("contact_list_members")
}

model BusinessCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tenants   Tenant[]

  @@map("business_categories")
}

model ChatbotFlow {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  trigger     String
  keywords    String[]
  nodes       Json
  edges       Json
  isActive    Boolean   @default(false)
  webhookTokenHash String? @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flowRuns    FlowRun[]

  @@index([businessId])
  @@map("chatbot_flows")
}

model Ticket {
  id             String         @id @default(cuid())
  tenantId       String
  conversationId String?        @unique
  assignedToId   String?
  subject        String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  department     String?
  slaDeadline    DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  businessId     String
