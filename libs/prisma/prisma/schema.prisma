generator client {
  provider        = "prisma-client-js"
  output          = "../../../node_modules/.prisma/client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                   String                    @id @default(cuid())
  name                 String
  slug                 String                    @unique
  logo                 String?
  domain               String?                   @unique
  isActive             Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  /// Invite code of the user who referred this workspace at signup, if any.
  referredByCode       String?
  /// What kind of business this account is (IT, Education, …). Admin-editable list.
  categoryId           String?
  accountType          AccountType               @default(CLIENT)
  /// Only for RESELLER accounts.
  resellerType         ResellerType?
  /// The reseller that manages this client. Null for direct clients, resellers and the platform.
  parentId             String?
  /// The reseller credited with bringing this client in (commission). Usually equals parentId;
  /// kept separately so a client moved to another reseller keeps its referral history.
  referredById         String?
  /// Percentage of a referred client's payments owed to this reseller (0 to 100). Resellers only.
  commissionRate       Float?
  auditLogs            AuditLog[]
  blacklistEntries     BlacklistEntry[]
  businesses           Business[]
  calls                Call[]
  campaigns            Campaign[]
  chatbotFlows         ChatbotFlow[]
  cmsSections          CmsSection[]
  contactImports       ContactImport[]
  contacts             Contact[]
  conversations        Conversation[]
  departments          Department[]
  faqInteractions      FaqInteraction[]
  flowRuns             FlowRun[]
  handoverConfigs      HandoverConfig[]
  handovers            HandoverRequest[]
  knowledgeDocs        KnowledgeDoc[]
  knowledgeFaqSets     KnowledgeFaqSet[]
  leadQualifications   LeadQualificationConfig[]
  leads                Lead[]
  resellerRates        MessageRate[]             @relation("ResellerMessageRates")
  customerRates        MessageRate[]             @relation("CustomerMessageRates")
  templates            MessageTemplate[]
  notifications        Notification[]
  payments             Payment[]
  pipelineStages       PipelineStage[]
  customPlans          Plan[]                    @relation("CustomPlans")
  resellerPlans        Plan[]                    @relation("ResellerPlans")
  quickReplies         QuickReply[]
  commissionsGenerated ResellerCommission[]      @relation("CommissionClient")
  commissionsEarned    ResellerCommission[]      @relation("CommissionReseller")
  segments             Segment[]
  contactLists         ContactList[]
  callRecordings       CallRecording[]
  subscription         Subscription?
  tags                 Tag[]
  settings             TenantSettings?
  category             BusinessCategory?         @relation(fields: [categoryId], references: [id])
  parent               Tenant?                   @relation("AccountHierarchy", fields: [parentId], references: [id])
  children             Tenant[]                  @relation("AccountHierarchy")
  referredBy           Tenant?                   @relation("AccountReferrals", fields: [referredById], references: [id])
  referrals            Tenant[]                  @relation("AccountReferrals")
  tickets              Ticket[]
  users                User[]
  walletTransactions   WalletTransaction[]
  wallet               Wallet?
  webhookEndpoints     WebhookEndpoint[]
  whatsAppIntegrations WhatsAppIntegration[]
  whiteLabel           WhiteLabelConfig?

  @@index([parentId])
  @@index([referredById])
  @@map("tenants")
}

model Business {
  id                    String                   @id @default(cuid())
  tenantId              String
  name                  String
  slug                  String
  whatsappPhoneNumber   String?
  whatsappPhoneNumberId String?                  @unique
  whatsappBusinessId    String?
  whatsappAccessToken   String?
  whatsappVerifyToken   String?
  status                BusinessStatus           @default(ACTIVE)
  logo                  String?
  timezone              String                   @default("Asia/Kolkata")
  aiEnabled             Boolean                  @default(false)
  autoReply             Boolean                  @default(false)
  autoReplyDelay        Int                      @default(3)
  aiModel               String?
  aiSystemPrompt        String?
  aiPersonality         String?
  aiResponseTone        String?
  aiTemperature         Float                    @default(0.7)
  aiMaxTokens           Int                      @default(500)
  offHoursMessage       String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  whatsappAppSecret     String?
  aiInstructions        Json?
  businessHoursStart    String                   @default("09:00")
  businessHoursEnd      String                   @default("18:00")
  businessDays          Int[]                    @default([1, 2, 3, 4, 5])
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calls                 Call[]
  campaigns             Campaign[]
  chatbotFlows          ChatbotFlow[]
  contactImports        ContactImport[]
  contacts              Contact[]
  conversations         Conversation[]
  departments           Department[]
  faqInteractions       FaqInteraction[]
  flowRuns              FlowRun[]
  handoverConfig        HandoverConfig?
  handovers             HandoverRequest[]
  knowledgeDocs         KnowledgeDoc[]
  knowledgeFaqSets      KnowledgeFaqSet[]
  leadQualification     LeadQualificationConfig?
  leads                 Lead[]
  templates             MessageTemplate[]
  messages              Message[]
  quickReplies          QuickReply[]
  tags                  Tag[]
  contactLists          ContactList[]
  tickets               Ticket[]
  whatsappIntegrations  WhatsAppIntegration[]

  @@unique([slug, tenantId])
  @@index([tenantId])
  @@map("businesses")
}

model WhatsAppIntegration {
  id                     String         @id @default(cuid())
  tenantId               String
  // NOT unique. At most one row per business may have isDefault = true, and that is
  // enforced by a PARTIAL unique index that lives in raw SQL (migrations/manual/) because
  // Prisma cannot express a WHERE clause on a unique constraint. Writing it here as
  // `@unique` instead makes Prisma read the relation below as one-to-one and generate
  // `Business.whatsappIntegrations` as a single optional row — which breaks `_count` and
  // contradicts the whole point of this table, since a business holds several numbers.
  businessId             String
  displayName            String?
  phoneNumber            String?
  phoneNumberId          String         @unique
  whatsappBusinessId     String
  /// Encrypted (enc:v1). Null once the number is disconnected.
  accessToken            String?
  verifyToken            String?
  appSecret              String?
  isActive               Boolean        @default(true)
  isDefault              Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  codeVerificationStatus String?
  qualityRating          String?
  /// WhatsApp Business API messaging tier (1=250, 2=2000, 3=10000, 0=unlimited/day)
  messagingTier          Int            @default(1)
  /// When true, calling is switched on and off to match the department's business
  /// hours instead of being left on. Meta holds the live setting; a scheduler keeps
  /// it in step, so this is the intent and `callingEnabled` is the current state.
  callingFollowsBusinessHours Boolean @default(false)

  /// The Meta Commerce catalogue connected to this number, when there is one. Products
  /// live in Commerce Manager, not here — this is the pointer that lets us read them and
  /// send them, so there is one source of truth rather than a copy that drifts.
  catalogId                   String?

  /// Mirrors Meta's per-number calling setting (POST /{phone_number_id}/settings { calling }).
  callingEnabled         Boolean        @default(false)
  calls                  Call[]
  campaigns              Campaign[]
  conversations          Conversation[]
  business               Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tenant                 Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([businessId])
  @@map("whatsapp_integrations")
}

model TenantSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  waPhoneNumberId      String?
  waBusinessAccountId  String?
  waApiKey             String?
  waWebhookVerifyToken String?
  aiEnabled            Boolean  @default(false)
  aiModel              String   @default("gpt-4o-mini")
  autoReply            Boolean  @default(false)
  autoReplyDelay       Int      @default(3)
  aiPersonality        String?
  timezone             String   @default("Asia/Kolkata")
  businessHoursStart   String   @default("09:00")
  businessHoursEnd     String   @default("18:00")
  businessDays         Int[]    @default([1, 2, 3, 4, 5])
  offHoursMessage      String?
  smtpHost             String?
  smtpPort             Int?
  smtpUser             String?
  smtpPass             String?
  smtpFrom             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  onboardingCompleted  Boolean  @default(false)
  waAppSecret          String?
  /// API key for incoming webhook / external API access. Generated per tenant.
  apiKey               String?  @unique

  /// What happens when a trial or paid period runs out. Read from the PLATFORM tenant's
  /// row, which is where the policy for the whole product lives; the column sits here
  /// rather than in a table of its own so a reseller can later be given its own answer
  /// for its own clients without another migration.
  ///
  /// GRACE  — keep working for `planEndGraceDays`, then stop. The default, because the
  ///          first thing someone does after lapsing is come back and pay.
  /// BLOCK  — stop the paid features the moment the period ends.
  /// AUTO_CHARGE — take payment automatically. Needs recurring billing to be set up;
  ///          until it is, this behaves as GRACE rather than letting someone go unpaid.
  planEndBehaviour     String   @default("GRACE")
  planEndGraceDays     Int      @default(7)

  /// The platform's master switch for self-service top-ups. Read from the PLATFORM
  /// tenant. A plan may allow a wallet, but this turns the whole feature off at once —
  /// useful while payment is being set up, and the only way to stop it everywhere.
  walletEnabled        Boolean  @default(false)

  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model User {
  id                   String               @id @default(cuid())
  tenantId             String
  name                 String
  email                String
  password             String
  role                 UserRole             @default(AGENT)
  avatar               String?
  phone                String?
  isActive             Boolean              @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  /// This agent's own share of the workspace AI allowance, per billing period.
  ///
  /// Null means no personal cap: they draw on the tenant pool until the plan
  /// runs out, which is how every account behaved before this existed and stays
  /// the default. A number caps them individually so one agent cannot spend the
  /// month on AI Suggest before anyone else logs in.
  aiCreditLimit        Int?
  /// Requests this agent has made in the period named by aiCreditsPeriodStart.
  aiCreditsUsed        Int                  @default(0)
  /// Which billing period aiCreditsUsed belongs to.
  ///
  /// Carried so the counter can reset itself on first use in a new period rather
  /// than needing a cron: a nightly job that reset agent counters would have to
  /// know each tenant's billing window, and would zero the wrong ones every time
  /// a super-admin re-dated a custom plan.
  aiCreditsPeriodStart DateTime?
  /// Unique referral code for this user. Auto-generated on first access.
  /// Share with others — whoever signs up with it gets linked back here.
  inviteCode           String?              @unique
  /// Set true once the user clicks the verification link in their welcome email.
  /// Default true so existing accounts are unaffected by the migration.
  emailVerified        Boolean              @default(true)
  /// Single-use random hex token mailed at registration. Cleared on verification.
  emailVerifyToken     String?              @unique
  emailVerifyExpiry    DateTime?
  /// Per-event channel switches ({ newMessage: { inApp, desktop, sound, email }, … }).
  /// Null means the defaults in libs/common notification-prefs.ts.
  notificationPrefs    Json?
  /// When this membership was revoked. The row is kept rather than deleted so the
  /// messages, conversations and calls this person handled stay attributed to them —
  /// `Message.sentById` is nullable, so deleting the user would blank its whole history.
  /// A revoked membership is excluded from the team list and from the workspace switcher,
  /// and re-inviting the same person clears it (restoring their permission overrides).
  removedAt            DateTime?
  auditLogs            AuditLog[]
  blacklistAdded       BlacklistEntry[]     @relation("BlacklistCreatedBy")
  answeredCalls        Call[]               @relation("CallAnsweredBy")
  assignedConvs        Conversation[]       @relation("AssignedAgent")
  departments          DepartmentMember[]
  handovers            HandoverRequest[]    @relation("HandoverAssignee")
  leadActivities       LeadActivity[]
  assignedLeads        Lead[]               @relation("AssignedLeadAgent")
  messages             Message[]
  notifications        Notification[]
  resetTokens          PasswordResetToken[]
  pushSubscriptions    PushSubscription[]
  assignedTickets      Ticket[]             @relation("AssignedTicketAgent")
  userPermissions      UserPermission[]     @relation("UserPermissions")
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email, tenantId])
  @@index([email, removedAt])
  @@map("users")
}

model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  businessId String?
  userId     String
  type       NotificationType
  title      String
  body       String?
  href       String?
  data       Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

/// One browser's web-push endpoint. A user has one row per browser/device they allowed.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("push_subscriptions")
}

model Call {
  id                    String              @id @default(cuid())
  /// Meta's call id (wacid.…) — the key every Calling API request and webhook carries.
  waCallId              String              @unique
  tenantId              String
  businessId            String
  whatsappIntegrationId String
  contactId             String
  conversationId        String?
  direction             CallDirection
  status                CallStatus          @default(RINGING)
  answeredById          String?
  fromPhone             String
  toPhone               String
  ringingAt             DateTime            @default(now())
  answeredAt            DateTime?
  endedAt               DateTime?
  durationSec           Int?
  errorCode             Int?
  errorTitle            String?
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @default(now()) @updatedAt
  recording             CallRecording?
  answeredBy            User?               @relation("CallAnsweredBy", fields: [answeredById], references: [id], onUpdate: NoAction)
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact               Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation          Conversation?       @relation(fields: [conversationId], references: [id], onUpdate: NoAction)
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  integration           WhatsAppIntegration @relation(fields: [whatsappIntegrationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, status])
  @@index([contactId])
  @@map("calls")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Contact {
  id              String            @id @default(cuid())
  tenantId        String
  name            String
  phone           String
  email           String?
  company         String?
  designation     String?
  location        String?
  source          String?
  avatarUrl       String?
  isBlocked       Boolean           @default(false)
  optedOut        Boolean           @default(false)
  customFields    Json?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  businessId      String
  waId            String?
  calls           Call[]
  campaignsSent   CampaignContact[]
  tags            ContactTag[]
  lists           ContactListMember[]
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  faqInteractions FaqInteraction[]
  flowRuns        FlowRun[]
  leads           Lead[]

  @@unique([phone, businessId])
  @@index([tenantId])
  @@index([businessId])
  @@map("contacts")
}

model ContactImport {
  id         String   @id
  tenantId   String
  businessId String
  userId     String?
  fileName   String?
  sheetName  String?
  mode       String   @default("skip")
  total      Int      @default(0)
  created    Int      @default(0)
  updated    Int      @default(0)
  skipped    Int      @default(0)
  failed     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([businessId, createdAt])
  @@map("contact_imports")
}

model Tag {
  id         String       @id @default(cuid())
  tenantId   String
  name       String
  color      String       @default("#6366f1")
  createdAt  DateTime     @default(now())
  businessId String
  contacts   ContactTag[]
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([name, businessId])
  @@index([businessId])
  @@map("tags")
}

model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model Conversation {
  id                    String               @id @default(cuid())
  tenantId              String
  contactId             String
  assignedToId          String?
  status                ConversationStatus   @default(OPEN)
  channel               String               @default("WHATSAPP")
  isAiActive            Boolean              @default(false)
  unreadCount           Int                  @default(0)
  labels                String[]
  lastMessageAt         DateTime?
  lastMessagePreview    String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  businessId            String
  activeFlowId          String?
  activeNodeId          String?
  flowVars              Json?
  whatsappIntegrationId String?
  calls                 Call[]
  assignedTo            User?                @relation("AssignedAgent", fields: [assignedToId], references: [id])
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact               Contact              @relation(fields: [contactId], references: [id])
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappIntegration   WhatsAppIntegration? @relation(fields: [whatsappIntegrationId], references: [id])
  faqInteractions       FaqInteraction[]
  flowRuns              FlowRun[]
  handovers             HandoverRequest[]
  messages              Message[]
  ticket                Ticket?

  @@index([tenantId, status])
  @@index([businessId, status])
  @@index([businessId, lastMessageAt(sort: Desc)])
  @@index([whatsappIntegrationId])
  @@index([businessId, whatsappIntegrationId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  sentById       String?
  waMessageId    String?          @unique
  type           MessageType      @default(TEXT)
  direction      MessageDirection
  content        String?
  mediaUrl       String?
  mediaType      String?
  mediaMimeType  String?
  mediaSize      Int?
  metadata       Json?
  status         MessageStatus    @default(PENDING)
  isNote         Boolean          @default(false)
  isAiGenerated  Boolean          @default(false)
  replyToId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  businessId     String?
  business       Business?        @relation(fields: [businessId], references: [id])
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy         User?            @relation(fields: [sentById], references: [id])

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@index([businessId])
  @@index([tenantId, direction, createdAt])
  @@map("messages")
}

model QuickReply {
  id         String   @id @default(cuid())
  tenantId   String
  shortcode  String
  content    String
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([shortcode, businessId])
  @@index([businessId])
  @@map("quick_replies")
}

model Lead {
  id               String         @id @default(cuid())
  tenantId         String
  contactId        String
  assignedToId     String?
  title            String
  score            Int            @default(0)
  scoreLabel       LeadScoreLabel @default(COLD)
  value            Float?
  currency         String         @default("INR")
  budget           String?
  authority        String?
  requirement      String?
  timeline         String?
  companySize      String?
  isDecisionMaker  Boolean        @default(false)
  notes            String?
  lostReason       String?
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  stageId          String
  businessId       String
  /// Where the lead came from: AI, MANUAL, IMPORT or API.
  qualifiedBy      String         @default("MANUAL")
  /// When the model last scored this lead, and what it concluded. Kept beside the
  /// human-editable fields rather than replacing them: an agent who corrects a budget
  /// should not have their correction overwritten by the next run, so a re-score only
  /// fills what is still empty.
  aiQualifiedAt    DateTime?
  aiScore          Int?
  /// How sure the model was, 0-100. A low number is worth a human reading the thread.
  aiConfidence     Int?
  aiSummary        String?
  aiIntent         String?
  aiNextStep       String?
  aiModel          String?
  /// Per-criterion scores and the weights applied, so a score can be explained.
  aiBreakdown      Json?
  /// The conversation the model read, for a link back to the thread.
  aiConversationId String?
  activities       LeadActivity[]
  assignedTo       User?          @relation("AssignedLeadAgent", fields: [assignedToId], references: [id])
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact          Contact        @relation(fields: [contactId], references: [id])
  stage            PipelineStage  @relation(fields: [stageId], references: [id])
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stageId])
  @@index([businessId, stageId])
  @@index([businessId, scoreLabel])
  @@index([businessId, aiQualifiedAt])
  @@map("leads")
}

model Department {
  id          String             @id @default(cuid())
  tenantId    String
  businessId  String
  name        String
  description String?
  /// A `StageColor` key from lib/utils, stored as text so the palette can grow.
  color       String             @default("slate")
  order       Int                @default(0)
  enabled     Boolean            @default(true)
  /// Where a handover goes when nothing more specific was chosen.
  isDefault   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  members     DepartmentMember[]
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  handovers   HandoverRequest[]

  @@unique([businessId, name])
  @@index([businessId, order])
  @@map("departments")
}

model DepartmentMember {
  id           String     @id @default(cuid())
  departmentId String
  userId       String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([departmentId, userId])
  @@index([userId])
  @@map("department_members")
}

model HandoverConfig {
  id                   String   @id @default(cuid())
  tenantId             String
  businessId           String   @unique
  enabled              Boolean  @default(true)
  /// The customer asks for a person, in any of the phrasings below.
  onCustomerRequest    Boolean  @default(true)
  requestKeywords      String[] @default([])
  /// The model says it is unsure, below this confidence out of 100.
  onAiUnsure           Boolean  @default(false)
  aiUnsureThreshold    Int      @default(50)
  /// After this many AI replies in a row with no human involved. 0 is off.
  afterAiReplies       Int      @default(0)
  /// The customer sounds unhappy.
  onNegativeSentiment  Boolean  @default(false)
  /// Outside the business hours set in general settings.
  offHours             Boolean  @default(false)
  /// LEAST_BUSY, ROUND_ROBIN, DEPARTMENT or SPECIFIC_USER.
  strategy             String   @default("LEAST_BUSY")
  departmentId         String?
  assignToId           String?
  /// Skip people who are not connected right now, and fall back to everyone if none are.
  onlineOnly           Boolean  @default(false)
  /// Stop the AI replying once a person owns the thread.
  pauseAi              Boolean  @default(true)
  notifyAgent          Boolean  @default(true)
  notifyManagers       Boolean  @default(false)
  /// Sent to the customer when the handover happens. Empty sends nothing.
  customerMessage      String?
  /// Tell managers if nobody has accepted after this many minutes. 0 is off.
  escalateAfterMinutes Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("handover_configs")
}

/// One conversation handed from the AI to a person, and what became of it.
model HandoverRequest {
  id             String       @id @default(cuid())
  tenantId       String
  businessId     String
  conversationId String
  contactId      String?
  /// CUSTOMER_REQUEST, FLOW_NODE, AI_UNSURE, AFTER_REPLIES, NEGATIVE_SENTIMENT,
  /// OFF_HOURS or MANUAL.
  reason         String
  /// What the flow or the agent wrote to explain it.
  note           String?
  /// The customer's own words that triggered it, for context on the queue screen.
  trigger        String?
  departmentId   String?
  assignedToId   String?
  /// PENDING when nobody could be found, ASSIGNED once it has an owner, ACCEPTED when
  /// they opened it, RESOLVED when the conversation was closed, CANCELLED if the AI
  /// took it back.
  status         String       @default("PENDING")
  requestedAt    DateTime     @default(now())
  assignedAt     DateTime?
  acceptedAt     DateTime?
  resolvedAt     DateTime?
  /// Set once managers have been told nobody picked it up.
  escalatedAt    DateTime?
  assignedTo     User?        @relation("HandoverAssignee", fields: [assignedToId], references: [id], onUpdate: NoAction)
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department     Department?  @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([businessId, status, requestedAt])
  @@index([conversationId])
  @@map("handover_requests")
}

model LeadQualificationConfig {
  id                  String   @id @default(cuid())
  tenantId            String
  businessId          String   @unique
  enabled             Boolean  @default(false)
  /// AFTER_MESSAGES, ON_HANDOVER, ON_CLOSE or MANUAL — when a conversation gets scored.
  trigger             String   @default("AFTER_MESSAGES")
  /// For AFTER_MESSAGES: how many messages from the customer before the first run.
  afterMessages       Int      @default(6)
  /// Score a conversation again later as it develops, and how long to wait first.
  requalify           Boolean  @default(true)
  requalifyAfterHours Int      @default(24)
  /// Only look at conversations mentioning one of these. Empty means every conversation.
  keywords            String[] @default([])
  /// Below this score no lead is created at all, so a browsing customer does not become
  /// a row somebody has to clear up. 0 creates one every time.
  minScore            Int      @default(0)
  autoCreate          Boolean  @default(true)
  /// Give the lead to whoever is handling the conversation.
  autoAssign          Boolean  @default(true)
  /// What this business counts as a good lead, in its own words. Added to the prompt.
  instructions        String?
  /// What the business sells, so the model can judge fit.
  productContext      String?
  /// Criterion weights out of 100: budget, authority, need, timeline, engagement.
  /// Null uses an even split across the five.
  weights             Json?
  /// Which pipeline stage a score band lands in: { qualified, hot, warm, cold }.
  stageMap            Json?
  /// Override the model for scoring. Null uses the business's reply model.
  model               String?
  /// Tell managers when a lead scores at or above this. 0 is off.
  notifyAboveScore    Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("lead_qualification_configs")
}

model PipelineStage {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  color     String       @default("slate")
  order     Int          @default(0)
  enabled   Boolean      @default(true)
  isDefault Boolean      @default(false)
  outcome   StageOutcome @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  leads     Lead[]
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, order])
  @@map("pipeline_stages")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  type      String
  content   String?
  metadata  Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_activities")
}

model MessageTemplate {
  id                        String     @id @default(cuid())
  tenantId                  String
  name                      String
  category                  String
  language                  String     @default("en")
  /// TEXT, IMAGE, VIDEO, DOCUMENT or LOCATION. Null for no header.
  headerType                String?
  /// Header text, or the resumable-upload handle of the sample media.
  headerContent             String?
  body                      String
  footer                    String?
  buttons                   Json?
  variables                 String[]
  waTemplateId              String?
  status                    String     @default("PENDING")
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  businessId                String
  lastSyncedAt              DateTime?
  rejectionReason           String?
  headerVariables           String[]   @default([])
  /// POSITIONAL ({{1}}) or NAMED ({{order_id}}). Meta rejects a template that mixes them.
  parameterFormat           String     @default("POSITIONAL")
  /// STANDARD, or CAROUSEL for a body plus 2-10 identically built cards.
  templateType              String     @default("STANDARD")
  /// Carousel cards: headerFormat, headerHandle, headerUrl, body, bodyVariables, buttons.
  cards                     Json?
  /// Limited-time offer badge (marketing only): its text and whether to run a countdown.
  ltoText                   String?
  ltoHasExpiration          Boolean    @default(false)
  /// Authentication templates: the security line, and when the code expires.
  addSecurityRecommendation Boolean    @default(false)
  codeExpirationMinutes     Int?
  /// How long Meta keeps retrying delivery before giving up.
  messageSendTtlSeconds     Int?
  /// The WhatsApp account this template lives in. A workspace can connect numbers from
  /// more than one account, and a template can only be sent from a number in its own —
  /// Meta answers 132001 otherwise. Null on rows that predate this.
  wabaId                    String?
  campaigns                 Campaign[]
  business                  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tenant                    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([name, businessId])
  @@index([businessId])
  @@index([businessId, wabaId])
  @@map("message_templates")
}

model Campaign {
  id                    String               @id @default(cuid())
  tenantId              String
  name                  String
  templateId            String?
  status                CampaignStatus       @default(DRAFT)
  scheduledAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  totalCount            Int                  @default(0)
  sentCount             Int                  @default(0)
  deliveredCount        Int                  @default(0)
  readCount             Int                  @default(0)
  repliedCount          Int                  @default(0)
  clickedCount          Int                  @default(0)
  failedCount           Int                  @default(0)
  filters               Json?
  metadata              Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  businessId            String
  lastError             String?
  costMinor             Int                  @default(0)
  /// Wallet cost estimated at launch, and what has actually been charged so far (paise).
  estimatedCostMinor    Int?
  /// Which WhatsApp number sends this campaign. Null = use the business's default.
  whatsappIntegrationId String?
  /// Set when the campaign stopped itself because every remaining send would fail the
  /// same way — a restricted account, or a template WhatsApp has disabled.
  haltedAt              DateTime?
  haltReason            String?
  haltErrorCode         Int?
  /// Recipients passed over without being a delivery failure: already opted out, or at
  /// WhatsApp's own per-person marketing limit. Kept apart so a sender's failure rate
  /// reflects messages that actually went wrong.
  skippedCount          Int                  @default(0)
  contacts              CampaignContact[]
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template              MessageTemplate?     @relation(fields: [templateId], references: [id])
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappIntegration   WhatsAppIntegration? @relation(fields: [whatsappIntegrationId], references: [id])

  @@index([tenantId, status])
  @@index([businessId, status])
  @@index([whatsappIntegrationId])
  @@map("campaigns")
}

model CampaignContact {
  id           String    @id @default(cuid())
  campaignId   String
  contactId    String?
  phone        String
  variables    Json?
  status       String    @default("PENDING")
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  repliedAt    DateTime?
  failedReason String?
  waMessageId  String?   @unique
  claimedAt    DateTime?
  /// What was charged to the wallet for this message (paise).
  costMinor    Int?
  clickedAt    DateTime?
  /// Where this recipient's tracked link points. Set when the campaign is built, so the
  /// redirect can send them on without re-deriving it at click time.
  clickUrl     String?
  /// How many times they followed it. The first one also stamps clickedAt.
  clickCount   Int       @default(0)
  /// WhatsApp error code from statuses[].errors[].code (e.g. 131026 = recipient not on WA)
  errorCode    Int?
  /// Human-readable title matching the error code
  errorTitle   String?
  /// WhatsApp's own explanation, verbatim, from statuses[].errors[].error_data.details.
  /// Kept apart from `failedReason`, which is our wording: when an error has to be taken
  /// to Meta support, what they said is the part that matters and ours is not evidence.
  errorDetail  String?
  failedAt     DateTime?
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact?  @relation(fields: [contactId], references: [id])

  @@index([campaignId, status])
  @@index([errorCode])
  @@index([campaignId, errorCode])
  @@map("campaign_contacts")
}

model BlacklistEntry {
  id          String   @id @default(cuid())
  tenantId    String?
  /// Digits-only E.164, normalised exactly like Contact.phone.
  phone       String   @unique(map: "blacklist_entries_global_phone_key", where: raw("(\"tenantId\" IS NULL)"))
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
  /// MANUAL, or OPT_OUT when WhatsApp told us this person stopped marketing messages.
  /// A person who opts back in clears only the automatic entry, never a manual block.
  source      String   @default("MANUAL")
  /// The WhatsApp error code that caused an automatic entry, e.g. 131050.
  errorCode   Int?
  createdBy   User?    @relation("BlacklistCreatedBy", fields: [createdById], references: [id])
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([phone])
  @@index([tenantId, source])
  @@map("blacklist_entries")
}

model WhiteLabelConfig {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  brandName        String
  logoUrl          String?
  faviconUrl       String?
  /// Hex colours, e.g. "#0f766e".
  primaryColor     String    @default("#059669")
  accentColor      String?
  /// Lower-case host without scheme or port, e.g. "crm.acme.com". Unique across the platform.
  domain           String?   @unique
  /// 180x180 PNG for an iOS home screen. Without it iOS crops a screenshot of the page.
  appleIconUrl     String?
  /// 1200x630 image shown when a link to this brand is shared — WhatsApp, LinkedIn, Slack.
  ogImageUrl       String?
  /// Browser chrome and installed-app colour. Falls back to the brand's primary colour.
  themeColor       String?
  supportEmail     String?
  supportPhone     String?
  website          String?
  address          String?
  loginHeadline    String?
  loginSubtext     String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  /// Free address on the platform's domain: "<subdomain>.<PLATFORM_ROOT_DOMAIN>".
  subdomain        String?   @unique
  /// The public landing page on the brand's domain (off = straight to login).
  landingEnabled   Boolean   @default(true)
  landingTitle     String?
  landingSubtitle  String?
  /// The brand's own legal text; empty = a standard template in the brand's name.
  termsContent     String?
  privacyContent   String?
  /// Monthly white-label fee for this reseller (paise); null = the platform default.
  feeOverrideMinor Int?
  /// When the current month's fee first failed to charge; cleared when paid.
  feeDueSince      DateTime?
  /// Set when the brand is switched off by the platform (e.g. unpaid fee). A suspended
  /// brand falls back to the platform's; the reseller can't lift it by toggling isActive.
  suspendedAt      DateTime?
  suspendedReason  String?
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("white_label_configs")
}

/// Platform-wide settings the super admin edits (single row, id "platform").
model PlatformConfig {
  id                  String   @id @default("platform")
  /// Monthly fee for white-label resellers, taken from their wallet (paise). 0 = free.
  whiteLabelFeeMinor  Int      @default(0)
  /// Days an unpaid fee is tolerated before the brand is suspended.
  whiteLabelGraceDays Int      @default(7)
  updatedAt           DateTime @default(now()) @updatedAt

  @@map("platform_config")
}

model Payment {
