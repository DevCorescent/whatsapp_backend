/// The audio of a call, captured in the agent's browser and stored on our side.
///
/// WhatsApp calling is WebRTC: the audio goes straight between the customer's phone and
/// the agent's browser and never passes through Meta or through us, so there is no
/// server in the media path to record from. Putting one there would mean running a media
/// server, which is a separate service with its own cost and latency. Instead the agent's
/// browser mixes both sides and uploads the result when the call ends.
///
/// The honest consequence, which the UI states rather than hides: if the tab is closed or
/// the network drops mid-call, that recording is incomplete or missing. A row is only
/// written once a file has actually been stored, so a recording that exists is whole.
model CallRecording {
  id          String   @id @default(cuid())
  callId      String   @unique
  tenantId    String
  businessId  String
  /// Object key in the media store, not a URL — URLs are signed on demand.
  storageKey  String
  mimeType    String
  sizeBytes   Int
  durationSec Int?
  createdAt   DateTime @default(now())

  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt(sort: Desc)])
  @@map("call_recordings")
}

/// A ready-made template anyone can copy into their own account.
///
/// Templates belong to a WhatsApp account and are approved by Meta per account, so a
/// template cannot be shared the way a document can — each business has to submit its own
/// copy. This is therefore a catalogue of starting points rather than of live templates:
/// copying one creates a real template in the copier's business, which they then submit
/// for approval themselves.
///
/// Curated by the platform. A tenant publishing into a shared library would mean one
/// customer's wording reaching another's account, which is nobody's expectation.
model TemplateLibraryItem {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  category    String
  language    String   @default("en")
  /// The template body, buttons and so on, in the same shape the builder writes.
  spec        Json
  /// Grouping for the browse screen, e.g. "Appointments", "Offers".
  industry    String?
  isActive    Boolean  @default(true)
  /// How many times it has been copied, so the useful ones can be found.
  useCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([isActive, industry])
  @@map("template_library_items")
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

/// RINGING → CONNECTING (an agent accepted, answer SDP sent to Meta) → IN_PROGRESS → COMPLETED.
/// MISSED when nobody answered before Meta hung up; REJECTED when an agent declined.
enum CallStatus {
  RINGING
  CONNECTING
  IN_PROGRESS
  COMPLETED
  MISSED
  REJECTED
  FAILED
}

/// Whether a customer who entered a flow ever came out the other side.
///
/// There is no ABANDONED value on purpose. Abandonment is not an event anyone
/// observes — the customer simply stops replying — so it cannot be written at
/// the moment it happens without a cron guessing when "stopped" began. A run
/// left IN_PROGRESS with no activity for a day IS abandoned, and deriving it at
/// read time is both simpler and always current.
enum FlowRunStatus {
  IN_PROGRESS
  COMPLETED
  HANDOFF
}

enum PlanChangeKind {
  UPGRADE
  DOWNGRADE
}

enum PlanChangeStatus {
  PENDING
  PAID
  APPLIED
  FAILED
  CANCELLED
}
