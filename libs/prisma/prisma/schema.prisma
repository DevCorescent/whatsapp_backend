  tenantId          String
  provider          String
  providerPaymentId String              @unique
  orderId           String?
  amountMinor       Int
  currency          String              @default("inr")
  /// "subscription" | "plan_change" | "renewal"
  purpose           String
  planId            String?
  createdAt         DateTime            @default(now())
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
